APP_NAME=hexagonal-go-api
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
RATE_LIMIT=100
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
ADMIN_EMAIL=admin@zitadel.localhost
ADMIN_PASSWORD=Admin1234!
ZITADEL_ENABLED=true
ZITADEL_URL=http://localhost:8081
ZITADEL_PROJECT_ID=tu_project_id_aqui
ZITADEL_CLIENT_ID=tu_client_id_aqui
ZITADEL_REDIRECT_URI=http://localhost:8085/auth/callback
ZITADEL_JWKS_URL=http://localhost:8081/oauth/v2/keys
ZITADEL_PAT=tu_service_account_personal_access_token_aqui
# Extension points for production adapters:
DATABASE_URL=postgres://postgres:postgres@postgres:5432/app?sslmode=disable
REDIS_ADDRESS=redis:6379
